# ==============================================================================
# Konfigurasi Environment — Sistem Manajemen Tagihan UKT Multi-Institusi
# Salin file ini menjadi .env sebelum menjalankan aplikasi:
#   cp .env.example .env
# ==============================================================================

# --- Konfigurasi Server Aplikasi ---
APP_ENV=development
APP_PORT=8080

# --- Konfigurasi Instance PostgreSQL Terpisah (Best Practice) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password
DB_NAME=ukt
DB_SSLMODE=disable

# --- Konfigurasi JWT ---
JWT_SECRET=change-this-jwt-secret-key-min-32-chars-2026
JWT_TTL=2h

# --- Secret HMAC-SHA256 Per Institusi (Wajib Diisi di .env Lokal) ---
# PENTING: Jangan pernah commit nilai secret produksi ke repositori Git!
# Untuk keperluan testing lokal/evaluator, isi sesuai secret yang dikirimkan via email
# atau gunakan nilai placeholder pengembangan di bawah ini pada file .env lokal Anda.
HMAC_SECRET_INST_1=replace_with_hmac_secret_univ_nusantara
HMAC_SECRET_INST_2=replace_with_hmac_secret_inst_teknologi_maju
HMAC_SECRET_INST_3=replace_with_hmac_secret_univ_merdeka
